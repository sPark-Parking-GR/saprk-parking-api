generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  OPERATOR_STAFF
  OPERATOR_ADMIN
  PLATFORM_ADMIN
}

enum VehicleType {
  CAR
  MOTORCYCLE
  VAN
  TRUCK
}

enum OperatorStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OperatorMemberRole {
  STAFF
  ADMIN
}

enum RateUnit {
  PER_MINUTE
  PER_BLOCK
  FLAT
}

enum CapScope {
  STAY
  ROLLING
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum SourceChannel {
  WEB
  MOBILE
  API
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum CreditTransactionType {
  CREDIT
  DEBIT
  REFUND
  PROMO
}

enum PromotionType {
  STANDARD
  FEATURED
  PREMIUM
}

enum IngestSource {
  OSM
  GOOGLE
}

enum RawPlaceStatus {
  PENDING
  PROCESSED
  REJECTED
  DUPLICATE
}

enum TileStatus {
  PENDING
  FETCHING
  FETCHED
  FAILED
}

// How a facility is used, so free public lots and commercial parking businesses are
// managed separately. OSM mixes both; Google only ever returns real businesses.
enum FacilityKind {
  BUSINESS    // commercial parking operation (paid; bookable candidate)
  FREE_PUBLIC // free public / on-street parking area — never bookable
  RESTRICTED  // private or customers-only — not public
  UNKNOWN     // insufficient source signal to classify
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  role          UserRole @default(USER)
  displayName   String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles            Vehicle[]
  wallet              Wallet?
  bookings            Booking[]
  reviews             Review[]
  operatorMemberships OperatorMembership[]

  @@index([email])
}

model Vehicle {
  id        String      @id @default(cuid())
  userId    String
  plate     String
  type      VehicleType
  label     String?
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([userId, plate])
  @@index([userId])
}

// ─── Wallet & Credits ─────────────────────────────────────────────────────────

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  currency     String   @default("EUR")
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id          String                @id @default(cuid())
  walletId    String
  amountCents Int
  type        CreditTransactionType
  description String?
  bookingId   String?
  createdAt   DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

// ─── Operator ─────────────────────────────────────────────────────────────────

model ParkingOperator {
  id          String         @id @default(cuid())
  name        String
  legalName   String?
  taxId       String?        @unique
  status      OperatorStatus @default(PENDING)
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  facilities     Facility[]
  memberships    OperatorMembership[]
  promotionPlans PromotionPlan[]
  tariffPlans    TariffPlan[]

  @@index([status])
}

model OperatorMembership {
  id         String             @id @default(cuid())
  operatorId String
  userId     String
  role       OperatorMemberRole
  createdAt  DateTime           @default(now())

  operator ParkingOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([operatorId, userId])
}

// ─── Facility ─────────────────────────────────────────────────────────────────

model Facility {
  id                  String   @id @default(cuid())
  operatorId          String
  name                String
  address             String
  lat                 Decimal  @db.Decimal(10, 7)
  lng                 Decimal  @db.Decimal(10, 7)
  totalCapacity       Int
  onlineQuota         Int
  vehicleTypes        VehicleType[]
  heightRestrictionCm Int?
  openingHoursJson    Json
  amenities           String[]
  cancellationPolicy  String   @default("")
  isActive            Boolean  @default(false)
  isVerified          Boolean  @default(false)
  rank                Int      @default(0)
  // Free public lot vs commercial parking business vs restricted. Classified at
  // ingestion; lets the two be surfaced and managed separately.
  kind                FacilityKind @default(UNKNOWN)
  // Ingestion provenance. Null for operator-created facilities; set for rows
  // promoted from RawPlace. sourceRef = OSM element id or Google place_id.
  source              IngestSource?
  sourceRef           String?
  sourceUpdatedAt     DateTime?
  contentHash         String?
  // Google enrichment is a refreshable cache (ToS: place_id may persist, other
  // fields must be refreshed). googleSyncedAt marks when the cached Google fields
  // were last pulled so a refresh job can re-fetch before the TTL lapses.
  googlePlaceId       String?  @unique
  googleSyncedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  operator         ParkingOperator            @relation(fields: [operatorId], references: [id])
  tariffAssignments FacilityTariffAssignment[]
  images           FacilityImage[]
  rules            FacilityRule[]
  bookings         Booking[]
  reviews          Review[]
  promotionPlan    PromotionPlan?

  // Generated geography point (kept in sync with lat/lng by the database). Managed
  // via raw SQL in the migration; Prisma treats it as an opaque column.
  geog Unsupported("geography(Point, 4326)")?

  @@unique([source, sourceRef])
  @@index([lat, lng])
  @@index([isActive, isVerified])
  @@index([kind, isActive])
  @@index([operatorId])
  @@index([geog], type: Gist)
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model FacilityRule {
  id         String @id @default(cuid())
  facilityId String
  ruleKey    String
  ruleValue  String

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, ruleKey])
}

// ─── Tariff ───────────────────────────────────────────────────────────────────

model TariffPlan {
  id               String        @id @default(cuid())
  operatorId       String
  name             String
  isActive         Boolean       @default(true)
  // Catch-all for any facility vehicle-type slot with no explicit override. Only a
  // plan with empty vehicleTypes (prices everything) may be default. At most one
  // active default per operator (partial unique index in the migration); required
  // once an operator has 2+ active plans, enforced in the service layer.
  isDefault        Boolean       @default(false)
  validFrom        DateTime?
  validTo          DateTime?
  // IANA zone for all wall-clock window math (DST-correct). Never server-local.
  timezone         String        @default("Europe/Athens")
  // Free leading minutes before billing starts.
  graceMinutes     Int           @default(0)
  // Billing granularity: total billable minutes round up to this.
  incrementMinutes Int           @default(60)
  // Vehicle classes this plan prices; empty = all.
  vehicleTypes     VehicleType[]
  // Bumped on any edit; quotes pin (planId, version) so price can't shift mid-hold.
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  operator          ParkingOperator            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  facilityAssignments FacilityTariffAssignment[]
  tiers             RateTier[]
  windows           RateWindow[]
  caps              RateCap[]

  @@index([operatorId, isActive])
}

// Assigns a plan to a facility for one concrete vehicle type. A plan may back many
// rows/facilities; a facility may have up to one row per VehicleType. Any vehicle
// type with no row here falls back to the operator's default plan (TariffPlan.isDefault)
// — there is no per-facility wildcard/catch-all row anymore.
model FacilityTariffAssignment {
  id           String      @id @default(cuid())
  facilityId   String
  tariffPlanId String
  vehicleType  VehicleType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tariffPlan TariffPlan @relation(fields: [tariffPlanId], references: [id], onDelete: Cascade)

  @@unique([facilityId, vehicleType])
  @@index([tariffPlanId])
}

// Partitions the 24h clock for time-of-day pricing (e.g. Day vs Night). With no
// windows a plan gets one implicit all-day window, collapsing to duration-only.
model RateWindow {
  id          String @id @default(cuid())
  planId      String
  label       String
  // Bitmask, bit 0 = Monday .. bit 6 = Sunday; 127 = every day.
  dayMask     Int    @default(127)
  // Minute-of-day, inclusive [0,1440).
  startMinute Int
  // Minute-of-day, exclusive; <= startMinute wraps past midnight.
  endMinute   Int

  plan  TariffPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  rates TariffRate[]

  @@index([planId])
}

// Duration-progressive structure. Tiers tile the cumulative-minute axis [0,∞);
// exactly one tier is open-ended (toMinute = null).
model RateTier {
  id           String   @id @default(cuid())
  planId       String
  // Inclusive cumulative-minute boundary.
  fromMinute   Int
  // Exclusive cumulative-minute boundary; null = open-ended.
  toMinute     Int?
  unit         RateUnit
  // Block size for PER_BLOCK (60 = hourly, 15 = quarter-hour); null otherwise.
  blockMinutes Int?

  plan  TariffPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  rates TariffRate[]

  @@index([planId])
}

// Price for a (tier, window) pair. A row per cell of the duration×clock grid.
model TariffRate {
  id         String @id @default(cuid())
  tierId     String
  windowId   String
  priceCents Int
  currency   String @default("EUR")

  tier   RateTier   @relation(fields: [tierId], references: [id], onDelete: Cascade)
  window RateWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  @@unique([tierId, windowId])
  @@index([tierId])
  @@index([windowId])
}

// Clamps the running total over a window. windowMinutes = 1440 → daily cap.
model RateCap {
  id            String   @id @default(cuid())
  planId        String
  windowMinutes Int
  capCents      Int
  scope         CapScope @default(ROLLING)

  plan TariffPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id               String        @id @default(cuid())
  facilityId       String
  userId           String?
  vehicleId        String?
  guestEmail       String?
  guestPhone       String?
  vehiclePlate     String
  vehicleType      VehicleType
  startsAt         DateTime
  endsAt           DateTime
  quotedPriceCents Int
  finalPriceCents  Int?
  currency         String        @default("EUR")
  status           BookingStatus @default(PENDING_PAYMENT)
  accessCode       String        @unique
  qrTokenHash      String?       @unique
  sourceChannel    SourceChannel @default(WEB)
  idempotencyKey   String?       @unique
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  facility      Facility               @relation(fields: [facilityId], references: [id])
  user          User?                  @relation(fields: [userId], references: [id])
  vehicle       Vehicle?               @relation(fields: [vehicleId], references: [id])
  statusHistory BookingStatusHistory[]
  payment       Payment?
  refund        Refund?

  @@index([facilityId, startsAt, endsAt])
  @@index([facilityId, status])
  @@index([userId])
  @@index([status, expiresAt])
  @@index([accessCode])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  note      String?
  changedBy String?
  changedAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amountCents       Int
  currency          String        @default("EUR")
  provider          String
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  refund  Refund?
}

model Refund {
  id               String       @id @default(cuid())
  bookingId        String       @unique
  paymentId        String       @unique
  amountCents      Int
  currency         String       @default("EUR")
  reason           String?
  providerRefundId String?
  status           RefundStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

// ─── Promotion ────────────────────────────────────────────────────────────────

model PromotionPlan {
  id         String        @id @default(cuid())
  facilityId String        @unique
  operatorId String
  type       PromotionType @default(STANDARD)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  operator ParkingOperator @relation(fields: [operatorId], references: [id])
}

// ─── Review ───────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  facilityId String
  userId     String
  bookingId  String?
  rating     Int
  body       String?
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([facilityId, userId])
  @@index([facilityId])
}

// ─── Ingestion ────────────────────────────────────────────────────────────────

// Landing zone for external data (OSM Overpass, Google Places). Raw payloads are
// stored untouched, then normalized, deduped and promoted to Facility. Never write
// external data straight to Facility.
model RawPlace {
  id          String         @id @default(cuid())
  source      IngestSource
  // OSM element id (e.g. "node/123") or Google place_id.
  sourceRef   String
  // 'node' | 'way' | 'relation' (OSM) or 'place' (Google).
  sourceType  String
  raw         Json
  lat         Decimal        @db.Decimal(10, 7)
  lng         Decimal        @db.Decimal(10, 7)
  tileId      String?
  // Hash of normalized payload; skip reprocessing when unchanged.
  contentHash String
  status      RawPlaceStatus @default(PENDING)
  // Set once promoted/matched to a Facility.
  facilityId  String?
  fetchedAt   DateTime       @default(now())
  processedAt DateTime?

  // Generated geography point, kept in sync with lat/lng by the database. Managed
  // via raw SQL in the migration; Prisma treats it as an opaque column.
  geog Unsupported("geography(Point, 4326)")?

  @@unique([source, sourceRef])
  @@index([status])
  @@index([tileId])
  @@index([geog], type: Gist)
}

// Bounding-box tiles driving the tiled extract. Tracks per-tile coverage so runs
// are incremental and resumable.
model IngestTile {
  id            String       @id @default(cuid())
  source        IngestSource
  south         Decimal      @db.Decimal(10, 7)
  west          Decimal      @db.Decimal(10, 7)
  north         Decimal      @db.Decimal(10, 7)
  east          Decimal      @db.Decimal(10, 7)
  status        TileStatus   @default(PENDING)
  resultCount   Int          @default(0)
  lastError     String?
  lastFetchedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([source, south, west, north, east])
  @@index([source, status])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
