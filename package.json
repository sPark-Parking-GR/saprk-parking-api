{
  "name": "@spark/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed:dev": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "bootstrap:admin": "ts-node --project tsconfig.seed.json src/scripts/bootstrap-admin.ts",
    "reconcile:purged": "ts-node --project tsconfig.seed.json src/scripts/reconcile-purged.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^6.1.0",
    "@spark/auth": "workspace:*",
    "@spark/maps": "workspace:*",
    "@spark/notifications": "workspace:*",
    "@spark/payments": "workspace:*",
    "@spark/subscription-billing": "workspace:*",
    "@spark/types": "workspace:*",
    "bullmq": "^5.34.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.10.1",
    "luxon": "^3.5.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supercluster": "^7.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@spark/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.1",
    "@types/supercluster": "^7.1.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
