PORT=3001

# Auth — set ONE provider and its required vars
AUTH_PROVIDER=authjs   # authjs | firebase | clerk | supabase

# Auth.js (credentials provider — JWT signing key, min 32 chars)
# generate: openssl rand -hex 32
AUTH_SECRET=

# Firebase (required — the invite flow always provisions Firebase operator identities;
# FIREBASE_API_KEY is the Web API key used for the REST password grant)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=

# Public base URL of the web app, used to build operator invite accept links
WEB_APP_URL=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Maps — set ONE provider and its required vars
MAP_PROVIDER=google    # google | mapbox

# Google Maps
GOOGLE_MAPS_API_KEY=

# Mapbox
MAPBOX_ACCESS_TOKEN=

# Payments — set ONE provider and its required vars
PAYMENT_PROVIDER=mock  # mock | stripe
# The mock provider accepts every payment without moving money, so boot refuses
# PAYMENT_PROVIDER=mock when NODE_ENV=production. Set to true ONLY for staging-like
# environments that intentionally run production builds without a real provider.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
# Required when PAYMENT_PROVIDER=mock. The mock verifies webhook signatures the same way
# the real provider does, so without this every delivery to /payments/webhook is rejected.
# generate: openssl rand -hex 32
MOCK_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Subscription billing (driver AND operator plans) — set ONE provider and its required vars.
# Separate from PAYMENT_PROVIDER on purpose: recurring subscriptions and one-shot booking
# payments are different engines with different webhook endpoints and secrets, so a
# deployment can take real card payments while subscription plans are still mocked.
SUBSCRIPTION_BILLING_PROVIDER=mock  # mock | stripe
# The mock provider grants a paid plan's perks without moving money, so boot refuses
# SUBSCRIPTION_BILLING_PROVIDER=mock when NODE_ENV=production. Set to true ONLY for
# staging-like environments that intentionally run production builds without a real provider.
ALLOW_MOCK_SUBSCRIPTION_BILLING_IN_PRODUCTION=false
# Required when SUBSCRIPTION_BILLING_PROVIDER=mock. The mock verifies webhook signatures the
# same way Stripe does, so without this every delivery to /driver-subscriptions/webhook and
# /operator-subscriptions/webhook is rejected. One secret covers both: the mock is driven
# locally and there is no second account to keep apart. generate: openssl rand -hex 32
MOCK_SUBSCRIPTION_WEBHOOK_SECRET=
# Required when SUBSCRIPTION_BILLING_PROVIDER=stripe. A SECOND signing secret, distinct from
# STRIPE_WEBHOOK_SECRET: Stripe issues one per endpoint, and the subscription endpoint is a
# different endpoint. STRIPE_SECRET_KEY above is reused — it is the same Stripe account.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
# Required when SUBSCRIPTION_BILLING_PROVIDER=stripe. A THIRD signing secret, for the same
# reason: /operator-subscriptions/webhook is a third Stripe endpoint on the same account, and
# a delivery signed for the driver endpoint must fail here rather than be accepted by it.
# The API refuses to boot if this equals STRIPE_SUBSCRIPTION_WEBHOOK_SECRET: pasted the same,
# each endpoint verifies the other's payloads and the separation is decoration.
STRIPE_OPERATOR_WEBHOOK_SECRET=
# Absolute base URL this API is reachable at, used to build the mock-checkout page link
# (and any other self-referential absolute URL). Mirrors WEB_APP_URL's role for the web app.
# Required when SUBSCRIPTION_BILLING_PROVIDER=mock; a real Stripe checkout page is hosted by
# Stripe and needs no address of ours. Must NOT include the /api/v1 prefix — it is appended.
API_PUBLIC_URL=http://localhost:3001

# Where operator upgrade requests (POST /operator-subscriptions/upgrade-request) are mailed.
# Optional: unset, the request is still recorded in the audit log and only the notification
# is skipped, with a warning in the logs.
PLATFORM_BILLING_CONTACT_EMAIL=

# Email — set ONE provider and its required vars
EMAIL_PROVIDER=console  # console | sendgrid
# Refused when NODE_ENV=production unless ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=true: the console
# provider prints invite accept URLs, live tokens included, to stdout instead of sending them.
ALLOW_CONSOLE_EMAIL_IN_PRODUCTION=false

# Sendgrid
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Push notifications (mobile app) — set ONE provider
PUSH_PROVIDER=console  # console | expo
# Refused when NODE_ENV=production unless ALLOW_CONSOLE_PUSH_IN_PRODUCTION=true: every push
# prints to stdout instead of being sent — a silent outage nobody is told about.
ALLOW_CONSOLE_PUSH_IN_PRODUCTION=false
# Optional even under PUSH_PROVIDER=expo: Expo's push API accepts unauthenticated requests
# by default. Only needed to enable Expo's "enhanced security" push sending.
EXPO_ACCESS_TOKEN=

# CORS (comma-separated origins, e.g. https://app.spark.com,https://admin.spark.com)
# Optional outside production (omit to allow all in dev/test).
# Required when NODE_ENV=production — boot fails otherwise.
CORS_ORIGIN=

# Proxy trust. Unset/false = use the socket address. Behind a load balancer this MUST be
# set, or every caller shares one rate-limit bucket and the audit log records the proxy's
# IP instead of the client's. Prefer the exact hop count (e.g. 1) or a trusted-address
# list over `true`, which lets anyone reaching this service forge X-Forwarded-For.
# Values: true | false | <hop count> | <comma-separated addresses/CIDRs>
TRUST_PROXY=

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://spark:spark@localhost:5432/spark

# Database connection retry (exponential backoff while DB unreachable)
DB_CONNECT_RETRY_BASE_MS=1000
DB_CONNECT_RETRY_MAX_MS=30000
DB_CONNECT_RETRY_FACTOR=2

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379

# Data ingestion — OSM Overpass API endpoint (omit to use the public instance)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Resource lifecycle — days a tombstoned (deleted-but-recoverable) resource stays
# restorable before the purge worker removes it permanently (users are anonymised
# in place instead of deleted). Default: 30.
LIFECYCLE_PURGE_RETENTION_DAYS=30

# ── Operator registration ────────────────────────────────────────────────────
# Pre-release the platform is invite-only: an existing platform admin issues an
# operator invitation and nobody else can get in. Set to true to open public
# operator sign-up, which lands the business PENDING for a platform admin to
# verify. A config change, not a deploy — and reversible the same way.
OPERATOR_SELF_SIGNUP_ENABLED=false

# ── First-admin bootstrap ────────────────────────────────────────────────────
# Read ONLY by `pnpm --filter @spark/api bootstrap:admin`. The API server never
# reads these and nothing here runs at startup.
#
# The command creates the very first SUPER_ADMIN — the only role that may act on
# user accounts — and refuses to run once one exists. It does NOT count existing
# PLATFORM_ADMIN accounts, so a deployment that already has them can still create
# its first super admin. Its password is generated randomly, printed once, and must be changed
# on first sign-in — there is deliberately no env var for it, because a password
# in the environment leaks into shell history and process listings.
BOOTSTRAP_ADMIN_EMAIL=
# Optional display name for that account.
BOOTSTRAP_ADMIN_NAME=
